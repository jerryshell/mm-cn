# 换行符与文本属性。Windows 上如果不显式声明，git 的 autocrlf 和文本嗅探
# 会改写下面的文件，而这两类文件被改动后会直接失效。

# 安装脚本是 UTF-8 无 BOM 的批处理，见 scripts/make_installer.py 里的编码说明。
# 仓库内存 LF 方便看 diff，检出时还原 CRLF —— 只有 LF 的批处理在 goto 和标签上会出问题。
# 不要改成 -text：那样会当成二进制，托管平台的网页端就没法直接阅读和 diff。
*.bat text eol=crlf

# 其它批处理相关文件同理
*.cmd text eol=crlf

# 翻译记忆是 UTF-8 JSONL，强制 LF，避免在 Windows 上检出成 CRLF 后
# 每行末尾多一个 \r（加载端虽然会 strip，但 diff 会全文件变红）
*.jsonl text eol=lf

# 源码、文档、配置统一 LF，避免跨平台协作时整文件 diff 全红
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.csv       text eol=lf
.gitignore  text eol=lf
.gitattributes -text

# 图片按二进制处理
*.png binary
*.jpg binary

# 发布包与游戏资源一律不进仓库（.gitignore 也会挡一层）
*.zip binary
*.assets binary
*.resS binary
*.ttf binary
